# Copiar a .env y completar usuario/contraseña:
#   cp .env.example .env

# --- MariaDB (origen) ---
MARIADB_HOST=201.236.154.66
MARIADB_PORT=65500
MARIADB_DATABASE=worldwide
MARIADB_USER=
MARIADB_PASSWORD=
MARIADB_TABLE=marcas

# Query opcional. Si queda vacío: SELECT * FROM <MARIADB_TABLE>
# MARIADB_QUERY=SELECT * FROM marcas WHERE fecha >= CURDATE() - INTERVAL 7 DAY

# --- BigQuery (destino) ---
GCP_PROJECT_ID=worldwide-470917
BQ_DATASET=cr_reportes
BQ_TABLE=marcas_mariadb
# WRITE_TRUNCATE | WRITE_APPEND | WRITE_EMPTY
BQ_WRITE_DISPOSITION=WRITE_TRUNCATE

# Credenciales GCP (opcional si ya usas gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account.json
