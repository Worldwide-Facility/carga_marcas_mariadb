# Copiar a .env y completar la API key:
#   cp .env.example .env

# --- API FRAX (origen de marcas) ---
FRAX_API_BASE=https://frax.controltienda.com/api/v1
FRAX_API_BASE_FALLBACK=https://frax2.controltienda.com/api/v1
FRAX_API_KEY=
# Histórico publicado por FRAX. Hasta vacío = hoy (America/Santiago).
FRAX_DESDE=2024-08-01
# FRAX_HASTA=
FRAX_PAGE_LIMIT=10000
# Pausa entre páginas. La API permite 30 solicitudes por minuto.
FRAX_PAGE_INTERVAL_SEC=2.1

# --- BigQuery (destino) ---
GCP_PROJECT_ID=worldwide-470917
BQ_DATASET=cr_reportes
BQ_TABLE=marcas_mariadb
BQ_TABLE_PERSONAS=personas_frax
# WRITE_TRUNCATE | WRITE_APPEND | WRITE_EMPTY
BQ_WRITE_DISPOSITION=WRITE_TRUNCATE

# Credenciales GCP (opcional si ya usas gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account.json
